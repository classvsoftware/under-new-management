  "bugs": {
    "url": "https://github.com/msfrisbie/under-new-management/issues"
  },
  "homepage": "https://github.com/msfrisbie/under-new-management#readme",
  "devDependencies": {
    "@parcel/config-webextension": "^2.12.0",
    "assert": "^2.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^5.5.0||^6.0.0",
    "crypto-browserify": "^3.12.0",
    "events": "^3.1.0",
    "https-browserify": "^1.0.0",
    "jsdom": "^28.1.0",
    "os-browserify": "^0.3.0",
    "parcel": "^2.12.0",
    "path-browserify": "^1.0.0",
    "postcss": "^8.4.35",
    "process": "^0.11.10",
    "punycode": "^1.4.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.1.0",
    "string_decoder": "^1.3.0",
    "tailwindcss": "^3.4.1",
    "url": "^0.11.0",
    "util": "^0.12.3",
    "vitest": "^4.0.18",
    "vm-browserify": "^1.1.2"
  },
  "dependencies": {
    "@types/chrome": "^0.0.262",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
